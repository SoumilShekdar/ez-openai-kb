generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "__DATABASE_PROVIDER__"
  url      = env("DATABASE_URL")
}

model KnowledgeBase {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  qdrantCollectionName String          @unique
  embeddingModel       String          @default("text-embedding-3-small")
  visibility           KbVisibility    @default(PRIVATE)
  ownerId              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  files                KnowledgeFile[]
  usageEvents          UsageEvent[]
  ingestionJobs        IngestionJob[]

  @@index([visibility])
  @@index([ownerId])
}

model KnowledgeFile {
  id              String        @id @default(cuid())
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  originalName    String
  importSource    ImportSource
  sourceUrl       String?
  status          FileStatus
  bytes           Int?
  mimeType        String?
  chunkCount      Int           @default(0)
  attributesJson  String?
  ingestionJob    IngestionJob?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([knowledgeBaseId, createdAt])
}

model IngestionJob {
  id              String        @id @default(cuid())
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeFile   KnowledgeFile @relation(fields: [knowledgeFileId], references: [id], onDelete: Cascade)
  knowledgeFileId String        @unique
  importSource    ImportSource
  sourceUrl       String?
  payload         Bytes
  status          FileStatus    @default(PENDING)
  attempts        Int           @default(0)
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([knowledgeBaseId, status, createdAt])
}

model UsageEvent {
  id              String          @id @default(cuid())
  sessionId       String
  eventType       UsageEventType
  keyMode         KeyMode
  knowledgeBase   KnowledgeBase?  @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  knowledgeBaseId String?
  createdAt       DateTime        @default(now())

  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
}

enum KbVisibility {
  PUBLIC
  PRIVATE
}

enum ImportSource {
  LOCAL
  DRIVE
  WEB
}

enum FileStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum UsageEventType {
  SEARCH
  CHAT
  FILE_ADD
  WEB_SEARCH
}

enum KeyMode {
  USER
  FALLBACK
}
